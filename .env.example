# URL du back NestJS, lue côté serveur uniquement (Route Handlers, proxy, Server Components).
# Le navigateur ne tape jamais le back en direct : il passe par /api/auth/* (cookies httpOnly).
# Requis en production (l'app échoue au boot si absent) ; fallback localhost en dev.
API_URL=http://localhost:3000

# Sentry — DSN vide = suivi d'erreurs désactivé. Public par nature (embarqué dans le bundle).
# NEXT_PUBLIC_SENTRY_DSN=
# Build seulement (Vercel) : envoi des source maps, puis suppression du build.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
